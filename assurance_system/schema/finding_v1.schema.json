{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finding_v1",
  "_status": "STUB — C5 rule engine fields pending PRE-04 (vocabulary contract)",
  "_authority": "10_TECHNICAL_SPECIFICATION_SIH26228.md §4; §9",
  "_implementation_task": "TASK-021",
  "_note": "UNAVAILABLE propagates at priority 1 in C5 rule engine. No aggregate risk score field permitted.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "finding_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "layer": { "type": "string", "_note": "C2 | C3 | C4 | C5 | DEFERRED" },
    "status": { "type": "string" },
    "method_findings": { "type": "array" },
    "unavailable_methods": { "type": "array", "items": { "type": "string" } },
    "deferred_methods": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "non_claims": { "type": "array", "items": { "type": "string" } },
    "analyst_disposition_prompt": { "type": "string" },
    "timestamp_utc": { "type": "string" }
