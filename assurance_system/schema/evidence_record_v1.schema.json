{
  "title": "Persisted evidence record",
  "description": "Supervisor-owned evidence_records representation from Technical Specification sections 4.2, 4.3, and 3.15.",
  "schema_version": "v1.0",
  "type": "object",
  "required": ["record_id", "schema_version", "asset_id", "method_id", "assessment_status", "access_mode", "artifact_unit_id", "coverage_gap_clean_label", "limitations", "non_claims", "assessment_timestamp", "worker_id", "is_synthetic", "created_at"],
  "prohibited": {
    "scope": "recursive",
    "field_names": ["risk\u005fscore", "aggregate\u005fassurance", "compromise\u005fprobability", "overall\u005fscore", "threat\u005fscore", "malicious\u005fprobability", "confidence\u005fscore", "trust\u005fscore", "safety\u005fscore"]
  },
  "properties": {
    "record_id": {"type": "string", "description": "Supervisor-generated UUID record identifier."},
    "schema_version": {"type": "string", "description": "Persisted record schema version."},
    "asset_id": {"type": "string", "description": "Supervisor-assigned asset identifier."},
    "method_id": {"type": "string", "description": "Assessment method identifier."},
    "assessment_status": {"type": "string", "description": "Frozen assessment-status value."},
    "raw_signal": {"type": ["object", "array", "string", "number", "boolean", "null"], "description": "Serialized method-specific observations."},
    "access_mode": {"type": "string", "description": "Declared assessment access mode."},
    "artifact_unit_id": {"type": "string", "description": "Artifact-unit definition identifier."},
    "coverage_gap_clean_label": {"type": ["boolean", "integer"], "description": "Permanent clean-label coverage-gap marker; true or persisted integer 1."},
    "limitations": {"type": "array", "description": "Non-empty method limitations."},
    "non_claims": {"type": "array", "description": "Non-empty assurance non-claims."},
    "dependency_declaration": {"type": ["object", "null"], "description": "Detector dependency declaration when applicable."},
    "assessment_timestamp": {"type": "string", "description": "Worker assessment timestamp."},
    "worker_id": {"type": "string", "description": "Producing worker identifier."},
    "record_digest": {"type": ["string", "null"], "description": "Supervisor-computed canonical record digest."},
    "is_synthetic": {"type": ["boolean", "integer"], "description": "Synthetic-fixture provenance marker."},
    "created_at": {"type": "string", "description": "SQLite persistence timestamp."}
  }
}
