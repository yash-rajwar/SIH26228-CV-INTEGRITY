{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deferred_record_v1",
  "_status": "STUB — pending PRE-04 (vocabulary contract)",
  "_authority": "10_TECHNICAL_SPECIFICATION_SIH26228.md §4; §09 §6 COMP-CAP",
  "_implementation_task": "TASK-020",
